# AppOS Container Configuration
# Used by docker-compose.yml

# Container
CONTAINER_NAME=appos
IMAGE_TAG=latest          # Options: latest (production), dev (development)
RESTART_POLICY=unless-stopped
DATA_DIR=/appos/data

# Network
HTTP_PORT=9091
TUNNEL_SSH_PORT=9222      # Public SSH port exposed to tunnel clients

# Initialization
INIT_MODE=auto                # auto: create superuser from env vars | setup: create via web UI

# Credentials
SUPERUSER_EMAIL=admin@websoft9.com
SUPERUSER_PASSWORD=changeme123

# Redis Runtime URL
REDIS_URL=redis://127.0.0.1:6379

# VictoriaMetrics / TSDB Runtime URL
TSDB_URL=http://127.0.0.1:8428
