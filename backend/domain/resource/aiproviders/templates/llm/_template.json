{
  "kind": "llm",
  "category": "AI",
  "endpointMode": "customizable",
  "description": "Reusable AI provider profile.",
  "defaultAuthScheme": "api_key",
  "capabilities": ["chat"],
  "fields": [
    {
      "id": "endpoint",
      "label": "Endpoint",
      "type": "url",
      "required": true,
      "placeholder": "https://api.example.com/v1"
    },
    {
      "id": "credential",
      "label": "API Key",
      "type": "secret_ref",
      "required": true,
      "sensitive": true,
      "secretTemplate": "single_value",
      "placeholder": "secretRef:..."
    },
    {
      "id": "max_completion_tokens",
      "label": "Max Completion Tokens",
      "type": "number",
      "placeholder": "4096",
      "helpText": "Optional upper bound for generated output tokens per response. Lower values reduce cost and avoid credit overrun."
    }
  ]
}