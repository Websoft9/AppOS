{
  "id": "vertex-ai",
  "title": "Google Vertex AI",
  "vendor": "Google Cloud",
  "uiGroup": "cloud_gateway",
  "hostingMode": "cloud",
  "serviceMode": "maas_platform",
  "endpointMode": "user_supplied",
  "providerMode": "gateway",
  "supportsClosedModels": true,
  "supportsMultiVendorModels": true,
  "description": "Google Cloud Vertex AI platform for enterprise model access and governance.",
