    },
    {
      "id": "project_id",
      "label": "Project ID",
      "type": "string",
      "placeholder": "my-gcp-project"
    },
    {
      "id": "location",
      "label": "Location",
      "type": "string",
      "default": "us-central1",
      "placeholder": "us-central1"
    },
    {
      "id": "credential",
      "label": "Access Token Secret",
      "type": "secret_ref",
      "required": true,
      "secretTemplate": "single_value"
    }
  ]
}