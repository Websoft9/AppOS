{
  "id": "azure-ai-foundry",
  "title": "Azure AI Foundry",
  "vendor": "Microsoft Azure",
  "providerMode": "gateway",
  "description": "Azure AI Foundry deployment endpoint with model selection governed through one Azure resource boundary.",
  "helpUrl": "https://learn.microsoft.com/azure/ai-foundry/",
  "defaultEndpoint": "https://{resource}.openai.azure.com/openai/deployments/{deployment}",
  "defaultEnabledModels": [
    "gpt-4o",
    "gpt-4o-mini",
    "o3-mini",
    "text-embedding-3-large"
  ],
  "capabilities": ["chat", "embeddings", "tools", "streaming"],
  "aliases": ["azure ai foundry", "azure-ai-foundry"],
  "fields": [
    {
      "id": "endpoint",
      "placeholder": "https://my-resource.openai.azure.com/openai/deployments/my-deployment"
    },
    {
      "id": "apiVersion",
      "label": "API Version",
      "type": "string",
      "placeholder": "2024-10-21"
    }
  ]
}