{
  "kind": "smtp",
  "category": "Messaging",
  "description": "Reusable SMTP connector profile.",
  "authPresentation": "username_password",
  "endpointShape": "host_port_tls",
  "defaultAuthScheme": "basic",
  "capabilities": ["email", "smtp"],
  "fields": [
    {
      "id": "endpoint",
      "label": "SMTP Server",
      "type": "string",
      "required": true,
      "placeholder": "smtp.example.com",
      "helpUrl": "https://support.websoft9.com/docs/smtps"
    },
    {
      "id": "port",
      "label": "Port",
      "type": "number",
      "required": true,
      "default": 587
    },
    {
      "id": "username",
      "label": "Username",
      "type": "string",
      "required": true,
      "placeholder": "mailer@example.com"
    },
    {
      "id": "credential",
      "label": "Password Secret",
      "type": "secret_ref",
      "secretTemplate": "single_value",
      "placeholder": "secretRef:..."
    },
    {
      "id": "tls",
      "label": "Use SSL",
      "type": "boolean",
      "default": false,
      "helpText": "Port 465 is usually used with SSL enabled; port 587 is usually used without implicit SSL."
    }
  ]
}