{
  "kind": "proxy",
  "category": "Integration",
  "description": "Reusable externally managed proxy connector profile.",
  "authPresentation": "mixed",
  "endpointShape": "url",
  "defaultAuthScheme": "none",
  "capabilities": ["proxy"],
  "fields": [
    {
      "id": "endpoint",
      "label": "Proxy Endpoint",
      "type": "url",
      "required": true,
      "placeholder": "http://proxy.example.com:8080"
    },
    {
      "id": "auth_mode",
      "label": "Authentication",
      "type": "select",
      "default": "none",
      "options": [
        { "label": "No authentication", "value": "none" },
        { "label": "Username + Password", "value": "username_password" },
        { "label": "Single Token / Secret", "value": "single_secret" }
      ]
    },
    {
      "id": "username",
      "label": "Username",
      "type": "string",
      "required": false,
      "showWhen": { "field": "auth_mode", "values": ["username_password"] },
      "placeholder": "proxy-user"
    },
    {
      "id": "credential",
      "label": "Password / Token / Secret",
      "type": "secret_ref",
      "required": false,
      "showWhen": { "field": "auth_mode", "values": ["username_password", "single_secret"] },
      "secretTemplate": "single_value",
      "placeholder": "secretRef:..."
    },
    {
      "id": "no_proxy",
      "label": "Bypass Hosts",
      "type": "string",
      "placeholder": "localhost,127.0.0.1,.internal",
      "helpText": "Comma-separated hosts, IPs, or domain suffixes that should bypass the proxy, for example localhost, 127.0.0.1, or .internal."
    }
  ]
}
