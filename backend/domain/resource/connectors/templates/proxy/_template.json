{
  "kind": "proxy",
  "category": "Integration",
  "description": "Reusable externally managed proxy connector profile.",
  "defaultAuthScheme": "basic",
  "capabilities": ["proxy"],
  "fields": [
    {
      "id": "endpoint",
      "label": "Proxy Endpoint",
      "type": "url",
      "required": true,
      "placeholder": "http://proxy.example.com:8080"
    },
    {
      "id": "auth_mode",
      "label": "Authentication",
      "type": "string",
      "required": true,
      "default": "none"
    },
    {
      "id": "username",
      "label": "Username",
      "type": "string",
      "placeholder": "proxy-user"
    },
    {
      "id": "credential",
      "label": "Password Secret",
      "type": "secret_ref",
      "secretTemplate": "single_value",
      "placeholder": "secretRef:..."
    },
    {
      "id": "no_proxy",
      "label": "Bypass Hosts",
      "type": "string",
      "placeholder": "localhost,127.0.0.1,.internal",
      "helpText": "Comma-separated hosts, IPs, or domain suffixes that should bypass the proxy, for example localhost, 127.0.0.1, or .internal."
    }
  ]
}