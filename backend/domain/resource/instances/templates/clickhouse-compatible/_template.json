{
  "kind": "clickhouse-compatible",
  "category": "database",
  "layoutPreset": "database_connection",
  "endpointShape": "host_port",
  "defaultPort": 8123,
  "credentialPresentation": "secret_or_inline",
  "credentialLabel": "password",
  "fields": [
    {
      "id": "username",
      "label": "Username",
      "type": "text",
      "required": true,
      "default": "default",
      "placeholder": "default"
    },
    {
      "id": "database",
      "label": "Database",
      "type": "text",
      "required": true,
      "default": "default",
      "placeholder": "default",
      "helpText": "ClickHouse commonly authenticates against the default database over the HTTP interface unless your deployment routes users to a named database."
    },
    {
      "id": "connect_timeout",
      "label": "Connection Timeout",
      "type": "number",
      "advanced": true,
      "default": 10
    },
    {
      "id": "ssl_enabled",
      "label": "Use SSL",
      "type": "boolean",
      "advanced": true,
      "hidden": true,
      "default": false
    },
    {
      "id": "ssl_ca_certificate",
      "label": "SSL Root CA Certificate",
      "type": "certificate_ref",
      "advanced": true,
      "showWhen": {
        "field": "ssl_mode",
        "values": ["mutual"]
      },
      "helpText": "Choose a CA certificate only when your ClickHouse server requires custom SSL trust."
    }
  ]
}
