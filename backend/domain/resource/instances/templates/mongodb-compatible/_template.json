{
  "kind": "mongodb-compatible",
  "category": "database",
  "layoutPreset": "database_connection",
  "endpointShape": "host_port",
  "defaultPort": 27017,
  "credentialPresentation": "secret_or_inline",
  "credentialLabel": "password",
  "fields": [
    {
      "id": "username",
      "label": "Username",
      "type": "text",
      "required": true,
      "default": "root",
      "placeholder": "appuser"
    },
    {
      "id": "database",
      "label": "Database",
      "type": "text",
      "required": true,
      "default": "appdb",
      "placeholder": "appdb",
      "helpText": "Use the logical database your app targets. AppOS keeps authSource separate so admin-scoped users can still authenticate against a different database."
    },
    {
      "id": "connect_timeout",
      "label": "Connection Timeout",
      "type": "number",
      "advanced": true,
      "default": 10
    },
    {
      "id": "ssl_enabled",
      "label": "Use SSL",
      "type": "boolean",
      "advanced": true,
      "hidden": true,
      "default": false
    },
    {
      "id": "authSource",
      "label": "Auth Source",
      "type": "text",
      "advanced": true,
      "default": "admin",
      "placeholder": "admin",
      "helpText": "MongoDB commonly authenticates application users against admin or another dedicated auth database."
    },
    {
      "id": "ssl_ca_certificate",
      "label": "SSL Root CA Certificate",
      "type": "certificate_ref",
      "advanced": true,
      "showWhen": {
        "field": "ssl_mode",
        "values": ["mutual"]
      },
      "helpText": "Choose a CA certificate only when your MongoDB server requires custom SSL trust."
    }
  ]
}
