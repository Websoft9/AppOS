{
  "templateKey": "clickhouse",
  "requiredFiles": [
    "manifest.json",
    "inputs.schema.json",
    "render.json",
    "source.json",
    "compose/base.yml",
    "env/defaults.env"
  ],
  "manifest": {
    "contractVersion": "0.1",
    "key": "clickhouse",
    "category": "database",
    "serviceRoles": {
      "clickhouse": "primary"
    }
  },
  "inputs": {
    "fieldKeys": [
      "app_id",
      "version",
      "http_port",
      "site_url",
      "db_user",
      "db_name",
      "db_password"
    ],
    "secretBacked": [
      "db_password"
    ],
    "systemManaged": [
      "app_id"
    ]
  },
  "render": {
    "exposures": [
      {
        "label": "Web",
        "service": "clickhouse",
        "port": 8123,
        "protocol": "http",
        "default": true
      }
    ],
    "primaryService": "clickhouse",
    "secretRefs": [
      "db_password"
    ]
  },
  "source": {
    "originKind": "official",
    "templateRevision": "v0-initial",
    "adapterVersion": "v0"
  },
  "adapter": {
    "primaryService": "clickhouse",
    "publishKind": "http"
  }
}
