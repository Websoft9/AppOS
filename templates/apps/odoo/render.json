{
  "contractVersion": "0.1",
  "env": {
    "W9_ID": "${app_id}",
    "W9_REPO": "odoo",
    "W9_DIST": "community",
    "W9_VERSION": "${version}",
    "W9_HTTP_PORT": "8069",
    "W9_HTTP_PORT_SET": "${http_port}",
    "W9_URL": "${site_url}",
    "W9_DB_EXPOSE": "postgresql",
    "W9_DB_VERSION": "15",
    "W9_NETWORK": "${platform.network}",
    "HOST": "${app_id}-postgresql",
    "USER": "${app_id}",
    "PASSWORD": "${secret:db_password}",
    "POSTGRES_DB": "postgres",
    "POSTGRES_USER": "${app_id}",
    "POSTGRES_PASSWORD": "${secret:db_password}",
    "POSTGRES_INITDB_ARGS": "--data-checksums",
    "POSTGRES_HOST_AUTH_METHOD": "trust",
    "PGDATA": "/var/lib/postgresql/data"
  },
  "compose_values": {
    "primaryService": "odoo",
    "databaseService": "postgresql"
  },
  "files": [],
  "exposure": {
    "kind": "http",
    "service": "odoo",
    "targetPort": 8069
  }
}
