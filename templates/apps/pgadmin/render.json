{
  "contractVersion": "0.1",
  "env": {
    "W9_ID": "${app_id}",
    "W9_REPO": "dpage/pgadmin4",
    "W9_DIST": "community",
    "W9_VERSION": "${version}",
    "W9_HTTP_PORT": "80",
    "W9_HTTP_PORT_SET": "${http_port}",
    "W9_URL": "${site_url}",
    "W9_NETWORK": "${platform.network}",
    "PGADMIN_DEFAULT_EMAIL": "${admin_email}",
    "PGADMIN_DEFAULT_PASSWORD": "${secret:admin_password}",
    "PGADMIN_LISTEN_ADDRESS": "0.0.0.0"
  },
  "compose_values": {
    "primaryService": "pgadmin"
  },
  "files": [],
  "exposures": [
    {
      "label": "Web",
      "service": "pgadmin",
      "port": 80,
      "protocol": "http",
      "default": true
    }
  ]
}
