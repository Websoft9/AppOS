{
  "contractVersion": "0.1",
  "fields": [
    {
      "key": "app_id",
      "type": "string",
      "label": "App ID",
      "required": true,
      "default": "wordpress",
      "visibility": "system",
      "storage_mode": "system_managed"
    },
    {
      "key": "version",
      "type": "select",
      "label": "Version",
      "required": true,
      "default": "6.9",
      "visibility": "basic",
      "storage_mode": "operator_editable",
      "options": ["6.9", "latest"]
    },
    {
      "key": "http_port",
      "type": "port",
      "label": "HTTP Port",
      "required": true,
      "default": 9001,
      "visibility": "basic",
      "storage_mode": "operator_editable"
    },
    {
      "key": "site_url",
      "type": "domain",
      "label": "Site URL",
      "required": false,
      "default": "",
      "visibility": "advanced",
      "storage_mode": "operator_editable"
    },
    {
      "key": "admin_path",
      "type": "string",
      "label": "Admin Path",
      "required": true,
      "default": "/wp-admin",
      "visibility": "advanced",
      "storage_mode": "operator_editable"
    },
    {
      "key": "db_password",
      "type": "secret_ref",
      "label": "Database Password",
      "required": true,
      "default": null,
      "visibility": "basic",
      "storage_mode": "secret_backed"
    }
  ]
}
